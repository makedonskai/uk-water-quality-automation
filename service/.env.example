# Environment Agency API
EA_API_BASE_URL=https://environment.data.gov.uk/flood-monitoring
EA_API_TIMEOUT_SECONDS=10.0
EA_API_MAX_RETRIES=3

# Database
DATABASE_URL=sqlite:///./water.db

# Logging
LOG_LEVEL=INFO

# Anthropic Claude API
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Telegram (only needed if Python sends Telegram alerts directly;
# in V2 n8n still owns Telegram, so these can be left as placeholders)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here